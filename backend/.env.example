# ─────────────────────────────────────────────────────────────────────────────
# Revenue Guardian — backend environment
#
# Copy to backend/.env for local development. For a Vercel deployment, set the
# same keys in the backend project's Environment Variables (Settings →
# Environment Variables). Do not commit a filled-in copy of this file.
#
# Every value below is a placeholder. Nothing here is a working credential.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# LOCAL: the direct Supabase connection is fine.
#   postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
#
# VERCEL: use the *pooled* connection instead. Each serverless invocation opens
# its own client, so the direct connection runs out of Postgres slots quickly.
# Supabase → Project Settings → Database → Connection pooling (Transaction mode):
#   postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# Migrations cannot run through pgBouncer. See DEPLOYMENT.md for the one-off
# command that points at the direct connection.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys. Keep test keys (rzp_test_…) unless
# you intend real money to move; /api/system/status reports which mode is live.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXX

# Set when creating the webhook (Dashboard → Webhooks). Without it the webhook
# route cannot verify signatures and will reject every delivery.
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXX

# ── Diagnosis model ──────────────────────────────────────────────────────────
# Optional. Failure diagnosis falls back to a deterministic classifier when this
# is absent, so the agent still works — it just stops using the model.
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=openai

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# Primary sender (interntech.xyz). Set this, or the Meta pair below, or both —
# with both, Meta Graph is the fallback when the primary fails.
WHATSAPP_SEND_API_KEY=

# Meta Cloud API fallback.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Used when WhatsApp is unavailable or the customer has no phone number.
# For Gmail this must be a 16-character App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=XXXXXXXXXXXXXXXX
SMTP_FROM=you@example.com
SMTP_USE_TLS=true

# ── Deployment ───────────────────────────────────────────────────────────────
# Public URL of *this* backend. On Vercel set it to the deployed backend domain,
# e.g. https://revenue-guardian-api.vercel.app
APP_BASE_URL=http://localhost:3000

# Ignored by Vercel, which supplies its own port.
PORT=3000

# Browsers allowed to call this API — comma-separated, no trailing slashes.
# Leave empty for `*`, which is right for local development and wrong for a
# public deployment: the Test Agent and demo endpoints send real messages.
#   https://revenue-guardian.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Set to true to additionally accept any https://*.vercel.app origin, so that
# preview deployments of the frontend can talk to this backend.
ALLOW_VERCEL_PREVIEW_ORIGINS=false

# Shared secret for GET/POST /api/cron/retry-tick, which executes due retries.
# Vercel Cron sends it automatically as `Authorization: Bearer $CRON_SECRET`.
# Generate one with: openssl rand -hex 32
# On a Vercel deployment, scheduled retries are DISABLED until this is set.
CRON_SECRET=

# Set to false to switch off /api/demo/payment-failed, /api/demo/payment-captured
# and /api/demo/generate-batch. Those endpoints are unauthenticated and run the
# real pipeline — generate-batch will create payment links and send up to 200
# WhatsApp messages and emails in a single request. The Test Agent page is
# unaffected and remains the intended way to demonstrate one case.
DEMO_ENDPOINTS_ENABLED=true

# ── Policy limits ────────────────────────────────────────────────────────────
# Defaults the agent starts with. Saved policy settings in the database take
# precedence over these once an operator edits them on the Settings page.
MAX_RETRY_ATTEMPTS=2
MAX_OUTREACH_ATTEMPTS=2
COOLDOWN_HOURS=24
MINIMUM_RECOVERY_VALUE=100
HIGH_VALUE_THRESHOLD=25000
LOW_CONFIDENCE_THRESHOLD=0.60
