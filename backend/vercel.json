{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run vercel-build",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "dist/**,prisma/**,node_modules/.prisma/**,node_modules/@prisma/engines/**,node_modules/@prisma/client/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/retry-tick",
      "schedule": "*/5 * * * *"
    }
  ]
}
